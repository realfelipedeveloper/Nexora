{
  "name": "@nexora/core-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@nexora/config": "workspace:*",
    "@nexora/schemas": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "argon2": "0.45.1",
    "busboy": "^1.6.0",
    "express": "5.2.1",
    "file-type": "^22.1.1",
    "pg": "8.23.0"
  },
  "scripts": {
    "admin:provision": "tsx src/cli/provision-admin.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint . --max-warnings=0",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate deploy --config prisma.config.ts",
    "start": "node dist/services/core-api/src/main.js",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1"
  }
}
