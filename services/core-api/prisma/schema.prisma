generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SiteStatus {
  ACTIVE
  ARCHIVED
}

enum ContentEntryStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentEntryReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum MenuItemLinkType {
  INTERNAL
  EXTERNAL
}

enum RoutingPathKind {
  ROUTE
  ALIAS
  REDIRECT
}

model User {
  id                String     @id @default(uuid())
  email             String
  normalizedEmail   String     @unique
  displayName       String
  passwordHash      String
  isSystemAdmin     Boolean    @default(false)
  status            UserStatus @default(ACTIVE)
  passwordChangedAt DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions                Session[]
  siteRoleAssignments     SiteRoleAssignment[]     @relation("SiteRoleUser")
  siteRoleGrants          SiteRoleAssignment[]     @relation("SiteRoleGrantedBy")
  sectionRoleAssignments  SectionRoleAssignment[]  @relation("SectionRoleUser")
  sectionRoleGrants       SectionRoleAssignment[]  @relation("SectionRoleGrantedBy")
  contentAssignments      ContentEntryAssignment[] @relation("ContentEntryAssignee")
  contentAssignmentGrants ContentEntryAssignment[] @relation("ContentEntryAssignedBy")
  editorialComments       ContentEntryComment[]
  editorialReviews        ContentEntryReview[]
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, revokedAt, expiresAt])
}

model Site {
  id        String     @id @default(uuid())
  key       String     @unique
  name      String
  status    SiteStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  locales            Locale[]
  contentTypes       ContentType[]
  contentEntries     ContentEntry[]
  contentSnapshots   ContentEntrySnapshot[]
  contentAssignments ContentEntryAssignment[]
  editorialComments  ContentEntryComment[]
  editorialReviews   ContentEntryReview[]
  contentPlacements  ContentPlacement[]
  menus              Menu[]
  menuItems          MenuItem[]
  routingPaths       RoutingPath[]
  routes             Route[]
  routeAliases       RouteAlias[]
  redirects          Redirect[]
  roleAssignments    SiteRoleAssignment[]
  sectionAssignments SectionRoleAssignment[]
  sections           Section[]
  settings           SiteSetting[]

  @@index([status])
}

model GlobalSetting {
  key       String   @id
  value     Json     @default("{}")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  siteId    String
  key       String
  value     Json     @default("{}")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, key])
  @@index([key])
}

model Permission {
  key         String @id
  description String

  rolePermissions RolePermission[]
}

model Role {
  key         String @id
  name        String
  description String

  permissions        RolePermission[]
  siteAssignments    SiteRoleAssignment[]
  sectionAssignments SectionRoleAssignment[]
}

model RolePermission {
  roleKey       String
  permissionKey String

  role       Role       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@index([permissionKey])
}

model SiteRoleAssignment {
  id          String   @id @default(uuid())
  siteId      String
  userId      String
  roleKey     String
  grantedById String?
  createdAt   DateTime @default(now())

  site      Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user      User  @relation("SiteRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleKey], references: [key], onDelete: Restrict)
  grantedBy User? @relation("SiteRoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([siteId, userId, roleKey])
  @@index([userId, siteId])
  @@index([siteId, roleKey])
  @@index([grantedById])
}

model Locale {
  id        String   @id @default(uuid())
  siteId    String
  code      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  contentLocales ContentLocale[]
  menus          Menu[]
  routingPaths   RoutingPath[]
  routes         Route[]
  routeAliases   RouteAlias[]
  redirects      Redirect[]

  @@unique([siteId, code])
  @@unique([id, siteId])
}

model Section {
  id        String   @id @default(uuid())
  siteId    String
  parentId  String?
  key       String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site            Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent          Section?                @relation("SectionHierarchy", fields: [parentId, siteId], references: [id, siteId], onDelete: Restrict)
  children        Section[]               @relation("SectionHierarchy")
  placements      ContentPlacement[]
  roleAssignments SectionRoleAssignment[]

  @@unique([id, siteId])
  @@unique([siteId, key])
  @@index([siteId, parentId, createdAt, id])
}

model ContentPlacement {
  id             String   @id @default(uuid())
  siteId         String
  sectionId      String
  contentEntryId String
  isPrimary      Boolean  @default(false)
  position       Int      @default(0)
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId, siteId], references: [id, siteId], onDelete: Cascade)
  contentEntry ContentEntry @relation(fields: [contentEntryId, siteId], references: [id, siteId], onDelete: Cascade)

  @@unique([sectionId, contentEntryId])
  @@index([siteId, sectionId, isVisible, position, id])
  @@index([siteId, contentEntryId, isPrimary])
}

model SectionRoleAssignment {
  id          String   @id @default(uuid())
  siteId      String
  sectionId   String
  userId      String
  roleKey     String
  grantedById String?
  createdAt   DateTime @default(now())

  site      Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId, siteId], references: [id, siteId], onDelete: Cascade)
  user      User    @relation("SectionRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleKey], references: [key], onDelete: Restrict)
  grantedBy User?   @relation("SectionRoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([sectionId, userId, roleKey])
  @@index([siteId, sectionId, userId])
  @@index([userId, siteId])
  @@index([roleKey])
  @@index([grantedById])
}

model Menu {
  id        String   @id @default(uuid())
  siteId    String
  localeId  String
  key       String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site   Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  locale Locale     @relation(fields: [localeId, siteId], references: [id, siteId], onDelete: Restrict)
  items  MenuItem[]

  @@unique([id, siteId])
  @@unique([siteId, localeId, key])
  @@index([siteId, localeId, createdAt, id])
}

model MenuItem {
  id          String           @id @default(uuid())
  siteId      String
  menuId      String
  parentId    String?
  label       String
  position    Int              @default(0)
  isVisible   Boolean          @default(true)
  linkType    MenuItemLinkType
  routeId     String?
  externalUrl String?          @db.VarChar(2048)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  site     Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  menu     Menu       @relation(fields: [menuId, siteId], references: [id, siteId], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemHierarchy", fields: [parentId, menuId], references: [id, menuId], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemHierarchy")
  route    Route?     @relation(fields: [routeId, siteId], references: [id, siteId], onDelete: Restrict)

  @@unique([id, menuId])
  @@index([siteId, menuId, parentId, isVisible, position, id])
  @@index([siteId, routeId])
}

model RoutingPath {
  id        String          @id @default(uuid())
  siteId    String
  localeId  String
  path      String          @db.VarChar(1024)
  kind      RoutingPathKind
  createdAt DateTime        @default(now())

  site     Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  locale   Locale      @relation(fields: [localeId, siteId], references: [id, siteId], onDelete: Restrict)
  route    Route?
  alias    RouteAlias?
  redirect Redirect?

  @@unique([id, siteId, localeId])
  @@unique([siteId, localeId, path])
  @@index([siteId, localeId, kind, createdAt, id])
}

model Route {
  id             String   @id @default(uuid())
  siteId         String
  localeId       String
  pathId         String   @unique
  contentEntryId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  locale       Locale        @relation(fields: [localeId, siteId], references: [id, siteId], onDelete: Restrict)
  path         RoutingPath   @relation(fields: [pathId, siteId, localeId], references: [id, siteId, localeId], onDelete: Restrict)
  contentEntry ContentEntry? @relation(fields: [contentEntryId, siteId], references: [id, siteId], onDelete: Restrict)
  aliases      RouteAlias[]
  menuItems    MenuItem[]

  @@unique([id, siteId])
  @@unique([id, siteId, localeId])
  @@unique([pathId, siteId, localeId])
  @@index([siteId, localeId, createdAt, id])
  @@index([siteId, contentEntryId])
}

model RouteAlias {
  id        String   @id @default(uuid())
  siteId    String
  localeId  String
  pathId    String   @unique
  routeId   String
  createdAt DateTime @default(now())

  site   Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  locale Locale      @relation(fields: [localeId, siteId], references: [id, siteId], onDelete: Restrict)
  path   RoutingPath @relation(fields: [pathId, siteId, localeId], references: [id, siteId, localeId], onDelete: Cascade)
  route  Route       @relation(fields: [routeId, siteId, localeId], references: [id, siteId, localeId], onDelete: Cascade)

  @@unique([pathId, siteId, localeId])
  @@index([siteId, localeId, routeId, createdAt])
}

model Redirect {
  id           String   @id @default(uuid())
  siteId       String
  localeId     String
  sourcePathId String   @unique
  targetPath   String   @db.VarChar(1024)
  statusCode   Int      @default(301)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  locale     Locale      @relation(fields: [localeId, siteId], references: [id, siteId], onDelete: Restrict)
  sourcePath RoutingPath @relation(fields: [sourcePathId, siteId, localeId], references: [id, siteId, localeId], onDelete: Cascade)

  @@unique([sourcePathId, siteId, localeId])
  @@index([siteId, localeId, createdAt, id])
}

model ContentType {
  id            String   @id @default(uuid())
  siteId        String
  key           String
  displayName   String
  schemaVersion Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site           Site                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fields         FieldDefinition[]
  schemaVersions ContentTypeSchemaVersion[]
  entries        ContentEntry[]

  @@unique([siteId, key])
  @@unique([id, siteId])
}

model FieldDefinition {
  id            String   @id @default(uuid())
  contentTypeId String
  key           String
  label         String
  fieldType     String
  required      Boolean  @default(false)
  position      Int      @default(0)
  config        Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentType ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  @@unique([contentTypeId, key])
}

model ContentTypeSchemaVersion {
  id            String   @id @default(uuid())
  siteId        String
  contentTypeId String
  version       Int
  definition    Json
  createdAt     DateTime @default(now())

  contentType ContentType    @relation(fields: [contentTypeId, siteId], references: [id, siteId], onDelete: Cascade)
  entries     ContentEntry[]

  @@unique([contentTypeId, siteId, version])
  @@index([siteId, createdAt])
}

model ContentEntry {
  id            String             @id @default(uuid())
  siteId        String
  contentTypeId String
  schemaVersion Int                @default(1)
  revision      Int                @default(1)
  status        ContentEntryStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  site                     Site                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentType              ContentType              @relation(fields: [contentTypeId, siteId], references: [id, siteId], onDelete: Restrict)
  contentTypeSchemaVersion ContentTypeSchemaVersion @relation(fields: [contentTypeId, siteId, schemaVersion], references: [contentTypeId, siteId, version], onDelete: Restrict)
  contentLocales           ContentLocale[]
  assignments              ContentEntryAssignment[]
  editorialComments        ContentEntryComment[]
  editorialReviews         ContentEntryReview[]
  snapshots                ContentEntrySnapshot[]
  placements               ContentPlacement[]
  routes                   Route[]

  @@unique([id, siteId])
  @@index([siteId, contentTypeId, updatedAt])
  @@index([siteId, contentTypeId, status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([siteId, status, updatedAt])
}

model ContentEntryAssignment {
  id             String   @id @default(uuid())
  siteId         String
  contentEntryId String
  assigneeId     String
  assignedById   String
  createdAt      DateTime @default(now())

  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentEntry ContentEntry @relation(fields: [contentEntryId, siteId], references: [id, siteId], onDelete: Cascade)
  assignee     User         @relation("ContentEntryAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedBy   User         @relation("ContentEntryAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([contentEntryId, siteId, assigneeId])
  @@index([siteId, assigneeId, createdAt])
  @@index([assignedById])
}

model ContentEntryComment {
  id             String   @id @default(uuid())
  siteId         String
  contentEntryId String
  authorId       String
  body           String   @db.VarChar(4000)
  createdAt      DateTime @default(now())

  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentEntry ContentEntry @relation(fields: [contentEntryId, siteId], references: [id, siteId], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([contentEntryId, siteId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([siteId, authorId, createdAt])
}

model ContentEntryReview {
  id              String                     @id @default(uuid())
  siteId          String
  contentEntryId  String
  reviewerId      String
  decision        ContentEntryReviewDecision
  contentRevision Int
  note            String?                    @db.VarChar(4000)
  createdAt       DateTime                   @default(now())

  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentEntry ContentEntry @relation(fields: [contentEntryId, siteId], references: [id, siteId], onDelete: Cascade)
  reviewer     User         @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([contentEntryId, siteId, contentRevision, reviewerId, decision])
  @@index([contentEntryId, siteId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([siteId, reviewerId, createdAt])
}

model ContentEntrySnapshot {
  id             String             @id @default(uuid())
  siteId         String
  contentEntryId String
  contentTypeId  String
  actorId        String?
  revision       Int
  schemaVersion  Int
  status         ContentEntryStatus
  publishedAt    DateTime?
  locales        Json
  createdAt      DateTime           @default(now())

  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentEntry ContentEntry @relation(fields: [contentEntryId, siteId], references: [id, siteId], onDelete: Cascade)

  @@unique([contentEntryId, siteId, revision])
  @@index([contentEntryId, siteId, revision(sort: Desc)])
  @@index([siteId, createdAt(sort: Desc), id(sort: Desc)])
}

model ContentLocale {
  id             String   @id @default(uuid())
  siteId         String
  contentEntryId String
  localeId       String
  data           Json     @default("{}")
  schemaVersion  Int      @default(1)
  revision       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contentEntry ContentEntry @relation(fields: [contentEntryId, siteId], references: [id, siteId], onDelete: Cascade)
  locale       Locale       @relation(fields: [localeId, siteId], references: [id, siteId], onDelete: Restrict)

  @@unique([contentEntryId, localeId])
  @@index([siteId, localeId, updatedAt])
}

model AuditEvent {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([action, entity, entityId, createdAt(sort: Desc), id(sort: Desc)])
}
